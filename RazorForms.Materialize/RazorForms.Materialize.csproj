<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>

		<PackageId>RazorForms.Materialize</PackageId>
		<Title>RazorForms.Materialize</Title>
		<PackageVersion>2.0.0</PackageVersion>
		<PackageReleaseNotes>
			Initial release
		</PackageReleaseNotes>
		<Authors>Christian LeVesque</Authors>
		<Description>An abstraction on top of RazorForms that adds support for the MaterializeCSS library</Description>
		<Copyright>Copyright Christian LeVesque 2022</Copyright>
		<PackageProjectUrl>https://www.razorforms.com</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/christianlevesque/RazorForms</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>razor page form ui component materialize material</PackageTags>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference
			Condition=" '$(Configuration)' != 'Release' "
			Include="..\RazorForms\RazorForms.csproj"/>
		<PackageReference
			Condition=" '$Configuration)' == 'Release' "
			Include="RazorForms" Version="2.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="./README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

</Project>
